#AvatarCrate Button {
    min-height: 0;
}

#AvatarCrate .unity-object-field__input {
    height: 20px;
}

#EditSnap {
    flex-direction: row;
    align-items: center;
    align-self: stretch;
    margin: 4px 3px 2px 3px;
}

#EditSnapToggle {
    width: 22px;
    height: 20px;
    padding: 0;
    margin-right: 2px;
    border-width: 1px;
    border-radius: 3px;
    justify-content: center;
    align-items: center;
}

#EditSnapToggle > Image {
    width: 16px;
    height: 16px;
}

#EditSnap FloatField {
    flex-grow: 1;
    flex-basis: 0;
    margin-left: 4px;
}

#EditSnap FloatField > .unity-base-field__label {
    min-width: 0;
    padding-right: 4px;
}

#EditSnap FloatField > .unity-base-field__input {
    min-width: 32px;
}
